# ResearchForge Environment Configuration

# Application
RESEARCHFORGE_ENV=development
RESEARCHFORGE_DEBUG=true
RESEARCHFORGE_SECRET_KEY=change_this_to_a_secure_random_key_for_production
RESEARCHFORGE_API_HOST=127.0.0.1
RESEARCHFORGE_API_PORT=8000
RESEARCHFORGE_API_PREFIX=/api/v1

# Storage & Provenance
RESEARCHFORGE_DATA_DIR=./artifacts
RESEARCHFORGE_PROVENANCE_LEDGER=./artifacts/provenance.jsonl
RESEARCHFORGE_DATABASE_URL=sqlite+aiosqlite:///./artifacts/researchforge.db

# Execution Sandbox
RESEARCHFORGE_SANDBOX_STRICT=true
RESEARCHFORGE_MAX_EXECUTION_TIME_SEC=300
RESEARCHFORGE_MAX_MEMORY_MB=2048
RESEARCHFORGE_ALLOW_NETWORK_EXECUTION=false

# Cognitia Adapter
COGNITIA_ENABLED=true
COGNITIA_API_URL=http://127.0.0.1:8080
COGNITIA_API_KEY=
COGNITIA_MOCK_MODE=true

# External Scholarly Providers (Optional / Phase 1+)
OPENALEX_API_KEY=
CROSSREF_MAILTO=researcher@example.org
SEMANTIC_SCHOLAR_API_KEY=

# LLM / Reasoning Providers (Optional / Phase 1+)
LLM_PROVIDER=mock
OLLAMA_BASE_URL=http://127.0.0.1:11434
OPENAI_API_KEY=
